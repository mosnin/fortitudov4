# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk v7 reads SIGN_IN/UP_{FORCE,FALLBACK}_REDIRECT_URL. The legacy
# AFTER_SIGN_IN_URL / AFTER_SIGN_UP_URL vars are NOT read and are silently ignored.
# FALLBACK applies only when the flow carries no explicit redirect target.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/post-login
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
CLERK_WEBHOOK_SECRET=whsec_...

# Neon Postgres.
# The Vercel integration sets both of these; locally, copy them from the Neon
# dashboard. src/db/index.ts resolves whichever it finds and prefers the POOLED
# one — it also accepts any prefix an integration adds (STORAGE_POSTGRES_URL and
# friends), so you do not have to rename anything it sets.
#
# App runtime — POOLED. Host carries `-pooler`; it terminates at Neon's
# pgBouncer, which is what keeps a few hundred lambdas from exhausting the
# connection limit.
DATABASE_URL=postgresql://<user>:<password>@ep-<id>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#
# drizzle-kit (db:push / db:migrate) — DIRECT, no `-pooler`. DDL and catalog
# inspection must not go through a transaction-mode pooler, which can hand
# consecutive statements to different backends.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@ep-<id>.<region>.aws.neon.tech/<db>?sslmode=require

# Creem.io Payments
CREEM_API_KEY=...
CREEM_WEBHOOK_SECRET=...
NEXT_PUBLIC_CREEM_CHECKOUT_URL=https://checkout.creem.io

# Uploadthing
UPLOADTHING_TOKEN=...

# Email alerts (optional). If unset, notifications are in-app only.
# Uses Resend (https://resend.com).
RESEND_API_KEY=re_...
NOTIFY_FROM_EMAIL=studio@fortitudo.agency

# App
NEXT_PUBLIC_APP_URL=https://fortitudo.agency
