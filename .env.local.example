# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk v7 reads SIGN_IN/UP_{FORCE,FALLBACK}_REDIRECT_URL. The legacy
# AFTER_SIGN_IN_URL / AFTER_SIGN_UP_URL vars are NOT read and are silently ignored.
# FALLBACK applies only when the flow carries no explicit redirect target.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/welcome
CLERK_WEBHOOK_SECRET=whsec_...

# Supabase Postgres — the app reads DATABASE_URL (or POSTGRES_URL).
# App runtime: use the TRANSACTION pooler (port 6543):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# drizzle-kit migrations (db:push/db:migrate): use the SESSION pooler / direct
#   connection (port 5432).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Creem.io Payments
CREEM_API_KEY=...
CREEM_WEBHOOK_SECRET=...
NEXT_PUBLIC_CREEM_CHECKOUT_URL=https://checkout.creem.io

# Uploadthing
UPLOADTHING_TOKEN=...

# OpenAI — powers the conversational Brief (OpenAI Agents SDK).
# OPENAI_BRIEF_MODEL is optional; defaults to gpt-5.5. The Brief's system
# prompt (offerings + interview policy) is kept stable so OpenAI's automatic
# prompt caching reuses it and keeps token costs low.
OPENAI_API_KEY=sk-...
OPENAI_BRIEF_MODEL=gpt-5.5

# Tavily — research layer for the Brief agent (reads the prospect's existing
# site, studies competitors, pulls market context). Optional: if unset, the
# Brief still works, just without live research. https://tavily.com
TAVILY_API_KEY=tvly-...

# Email alerts (optional). If unset, notifications are in-app only.
# Uses Resend (https://resend.com).
RESEND_API_KEY=re_...
NOTIFY_FROM_EMAIL=studio@fortitudo.agency

# Rate limiting — durable limiter across serverless instances (optional).
# If unset, falls back to a best-effort in-memory limiter. https://upstash.com
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Error monitoring (optional). If unset, Sentry is a no-op. https://sentry.io
SENTRY_DSN=https://...@...ingest.sentry.io/...
NEXT_PUBLIC_SENTRY_DSN=https://...@...ingest.sentry.io/...

# App
NEXT_PUBLIC_APP_URL=https://fortitudo.agency
