# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/welcome
CLERK_WEBHOOK_SECRET=whsec_...

# Supabase Postgres
# On Vercel, the Supabase marketplace integration sets POSTGRES_URL automatically
# (NOT DATABASE_URL) — the app reads POSTGRES_URL / POSTGRES_PRISMA_URL / DATABASE_URL
# in that order and ignores any stale neon.tech URL. For local dev set DATABASE_URL
# to the connection POOLER URI (transaction mode, port 6543):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For running drizzle-kit migrations, the DIRECT connection (port 5432) also works.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Creem.io Payments
CREEM_API_KEY=...
CREEM_WEBHOOK_SECRET=...
NEXT_PUBLIC_CREEM_CHECKOUT_URL=https://checkout.creem.io

# Uploadthing
UPLOADTHING_TOKEN=...

# Email alerts (optional). If unset, notifications are in-app only.
# Uses Resend (https://resend.com).
RESEND_API_KEY=re_...
NOTIFY_FROM_EMAIL=studio@foritudo.agency

# App
NEXT_PUBLIC_APP_URL=https://foritudo.agency
